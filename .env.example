# Copy to `.env` in this directory — Bun auto-loads it, no dotenv needed.
# It must live at the repo root: the pipeline CLI runs from here (`bun run ocr`, `bun run
# render`), and Bun reads .env from the process working directory without walking up.
#
# The apps keep their own .env next to their package.json — see apps/*/.env.example.

# Sarvam AI — the OCR engine for P1.2. Get a key at https://dashboard.sarvam.ai
# Billing is per page (₹0.5 as of Feb 2026), so `bun run ocr` asks for --yes above 50 pages.
SARVAM_API_KEY=
