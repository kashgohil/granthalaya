{
  "name": "granthalaya",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@granthalaya/api' --filter 'web' dev",
    "dev:api": "bun run --filter '@granthalaya/api' dev",
    "dev:web": "bun run --filter 'web' dev",
    "dev:mobile": "bun run --filter 'mobile' start",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "triage": "bun packages/pipeline/src/cli.ts triage",
    "render": "bun packages/pipeline/src/cli.ts render",
    "ocr": "bun packages/pipeline/src/cli.ts ocr",
    "assemble": "bun packages/pipeline/src/cli.ts assemble",
    "validate": "bun packages/pipeline/src/cli.ts validate",
    "fonts:sync": "bun scripts/fetch-fonts.ts",
    "design:sync": "bun scripts/sync-design.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  },
  "patchedDependencies": {
    "expo-modules-jsi@57.0.4": "patches/expo-modules-jsi@57.0.4.patch"
  }
}
