# Copy to `apps/api/.env` — Bun auto-loads it, no dotenv needed.
# It must live in this directory: Bun reads .env from the process working directory
# and does not walk up to the repo root.

# Port to bind. Fails loudly if already in use.
API_PORT=4567

# Comma-separated CORS origins. Must match wherever the web dev server actually runs —
# `apps/web` uses --strictPort so it can't silently move to a port that isn't listed here.
API_CORS_ORIGINS=http://localhost:4568,http://localhost:8081

# The admin studio's Postgres. Migrations run at startup.
# Defaults to postgres://localhost:5432/granthalaya when unset.
DATABASE_URL=postgres://localhost:5432/granthalaya

# The pipeline's working area — source PDFs, rendered pages, draft packages.
# Defaults to the repo's `content/`, resolved from this app's source rather than from the
# working directory, so `bun run dev` from the root finds the same place.
# CONTENT_DIR=/absolute/or/relative/path

# The admin studio (P1.3). Both together or neither: unset, every /admin route answers 503
# and no login is possible. `bun run admin:password` mints a matching pair.
# There is no default, because a default password is a published password.
#
# NOTE the shape: double quotes and escaped dollars. Bun expands $NAME in .env even inside
# single quotes, and an argon2 hash is all $-delimited fields — pasted raw it silently becomes
# "=19=65536,..." and the right password stops working. The API refuses to start on a mangled
# one rather than let that look like a forgotten password.
#   ADMIN_PASSWORD_HASH="\$argon2id\$v=19\$m=65536,t=2,p=1\$…"
ADMIN_PASSWORD_HASH=
COOKIE_SECRET=

# How long a signed-in session lasts. Default: one week.
# SESSION_TTL_SECONDS=604800
