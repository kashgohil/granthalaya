# Copy to `apps/mobile/.env` — Expo loads .env from this directory, not the repo root.
# Only EXPO_PUBLIC_* variables are exposed to app code (and they ship in the bundle —
# never put secrets here).

# Base URL of apps/api. `localhost` only resolves from a simulator; on a physical device
# use your machine's LAN address, e.g. http://192.168.1.20:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
