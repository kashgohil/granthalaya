{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Workspace packages (`@granthalaya/*`) are consumed as TypeScript source — Metro
    // compiles them like app code, so no build step and no stale `dist/`.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
