# Copy to `packages/db/.env` — only needed to point drizzle-kit at a database other than the
# local default. Bun (and drizzle-kit) read .env from the process working directory and do not
# walk up, so this file is for commands run from *this* package: `db:generate`, `db:studio`.
#
# `apps/api` keeps its own copy of the same variable, for the same reason.

# Defaults to postgres://localhost:5432/granthalaya when unset.
DATABASE_URL=postgres://localhost:5432/granthalaya
